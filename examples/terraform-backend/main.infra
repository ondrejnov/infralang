const statePrefix = "application/production"
const lockTable = "terraform-locks"

terraform {
  requiredVersion: ">= 1.5.0",
  backend s3 = {
    bucket: "example-tfstate",
    key: f"{statePrefix}/terraform.tfstate",
    region: "eu-central-1",
    dynamodbTable: lockTable,
    encrypt: true,
  }
}

provider Terraform from "terraform.io/builtin/terraform"

configure terraform = Terraform({})

resource metadata = terraform.data("metadata", {
  input: {
    backend: "s3",
    bucket: "example-tfstate",
  },
})

output stateKey = metadata.output.backend
