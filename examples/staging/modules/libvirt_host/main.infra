terraform { requiredVersion: ">= 1.5.0" }

provider Libvirt from "dmacvicar/libvirt" version "~> 0.9.3"
provider Lvm from "github.com/ondrejnov/lvm" version "0.5.0"

# Provider handles are inherited from each host module call and emit no child provider blocks.
configure libvirt = Libvirt
configure lvm = Lvm

input common_config: object {
  base_image_path: string,
  bootstrap_root: string,
  bridge: string,
  cloudinit_directory: string,
  cloudinit_pool: string,
  gateway: string,
  interface_name: string,
  mtu: number,
  prefix_length: number,
  remote_host: string,
  remote_certificate_path?: string = "~/.ssh/id_rsa-cert.pub",
  remote_private_key_path?: string = "~/.ssh/id_rsa",
  remote_user?: string = "root",
  ssh_authorized_keys: list<string>,
  volume_group: string,
} with { description: "Configuration shared by all VMs on this libvirt host." }

input network_name: string with {
  description: "Name of the routed libvirt network.",
  validations: [{
    condition: length(trimspace(network_name)) > 0,
    errorMessage: "network_name must not be empty.",
  }],
}

input vms: map<object {
  adopt_existing?: bool = false,
  cpu_mode?: string,
  data_disk_size_gib?: number,
  disk_size_gib?: number = 10,
  ip_address: string,
  qemu_guest_agent_enabled?: bool = false,
  ram_mb?: number = 1024,
  running?: bool = true,
  serial_console_enabled?: bool = false,
  vcpu?: number = 2,
}> with {
  description: "Virtual machines managed on this libvirt host, keyed by hostname.",
  validations: [{
    condition: length(vms) > 0,
    errorMessage: "vms must contain at least one virtual machine.",
  }],
}

resource network = libvirt.network("main", {
  name: network_name,
  autostart: true,
  bridge: { delay: "0", name: common_config.bridge, stp: "on" },
  forward: { mode: "route" },
  ips: [{ address: common_config.gateway, family: "ipv4", prefix: common_config.prefix_length }],
  mtu: { size: common_config.mtu },
})

resource cloudinitPool = libvirt.pool("cloudinit", {
  name: common_config.cloudinit_pool,
  type: "dir",
  target: { path: common_config.cloudinit_directory },
  create: { autostart: true, build: true, start: true },
  destroy: { delete: false },
})

module vmModule "vm" from "../libvirt_vm" {
  adoptExisting: each.value.adopt_existing,
  commonConfig: common_config,
  cpuMode: each.value.cpu_mode,
  dataDiskSizeGib: each.value.data_disk_size_gib,
  diskSizeGib: each.value.disk_size_gib,
  hostname: each.key,
  ipAddress: each.value.ip_address,
  qemuGuestAgentEnabled: each.value.qemu_guest_agent_enabled,
  ramMb: each.value.ram_mb,
  running: each.value.running,
  serialConsoleEnabled: each.value.serial_console_enabled,
  vcpu: each.value.vcpu,
} using {
  libvirt: libvirt,
  lvm: lvm,
} with {
  forEach: vms,
  dependsOn: [network, cloudinitPool],
}

output vms = {for hostname, vm in vmModule: hostname => {
  disk_path: vm.disk_path,
  hostname: vm.hostname,
  ip_address: vm.ip_address,
}} with { description: "Details of the virtual machines managed on this libvirt host." }

output serial_console_enabled_vms = sort([
  for hostname, vm in vmModule: hostname if vm.serial_console_enabled
]) with { description: "VM hostnames with a PTY serial console configured." }
