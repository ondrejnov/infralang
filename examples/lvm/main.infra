terraform {
  requiredVersion: ">= 1.5.0",
}

provider Lvm from "github.com/ondrejnov/lvm" version "0.5.0"

# The provider manages logical volumes only. This volume group must already
# exist on the remote host. SSH settings are defined in ssh.infra.
input volumeGroup: string = "vg0"
input volumeName: string = "infralang-data"
input sizeGiB: number = 2

configure lvm = Lvm({
  ssh,
})

resource dataVolume = lvm.logicalVolume("data", {
  name: volumeName,
  size: sizeGiB *2,
  volumeGroup: volumeGroup,
}) with {
  lifecycle: {
    preventDestroy: true
  }
}

output volumeId = dataVolume.id
output volumePath = dataVolume.path
output volumeUuid = dataVolume.uuid
output actualSizeBytes = dataVolume.actual_size_bytes
