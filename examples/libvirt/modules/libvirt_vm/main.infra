terraform { requiredVersion: ">= 1.5.0" }

provider Libvirt from "dmacvicar/libvirt" version "~> 0.9.3"
provider Lvm from "github.com/ondrejnov/lvm" version "0.5.0"
provider Terraform from "terraform.io/builtin/terraform"

configure libvirt = Libvirt
configure lvm = Lvm
configure terraform = Terraform

input adoptExisting: bool = false with {
  description: "Adopt an existing VM without copying the base image or replacing its cloud-init ISO.",
}

input commonConfig: CommonConfig with {
  description: "Configuration shared by VM module instances.",
  validate startswith(commonConfig.baseImagePath, "/") else "common_config.base_image_path must be an absolute path.",
  validate startswith(commonConfig.bootstrapRoot, "/") else "common_config.bootstrap_root must be an absolute path.",
  validate startswith(commonConfig.cloudinitDirectory, "/") else "common_config.cloudinit_directory must be an absolute path.",
  validate length(trimspace(commonConfig.cloudinitPool)) > 0 else "common_config.cloudinit_pool must not be empty.",
  validate can(cidrhost(f"{commonConfig.gateway}/32", 0)) else "common_config.gateway must be a valid IPv4 address.",
  validate commonConfig.mtu >= 68 && commonConfig.mtu <= 65535 else "common_config.mtu must be between 68 and 65535.",
  validate commonConfig.prefixLength >= 0 && commonConfig.prefixLength <= 32 else "common_config.prefix_length must be between 0 and 32.",
  validate length(trimspace(commonConfig.remoteHost)) > 0 else "common_config.remote_host must not be empty.",
  validate length(trimspace(commonConfig.remoteCertificatePath)) > 0 else "common_config.remote_certificate_path must not be empty.",
  validate length(trimspace(commonConfig.remotePrivateKeyPath)) > 0 else "common_config.remote_private_key_path must not be empty.",
  validate length(commonConfig.sshAuthorizedKeys) > 0 else "common_config.ssh_authorized_keys must contain at least one public SSH key.",
}

input cpuMode: optional<string> with {
  description: "Optional libvirt CPU mode exposed to the guest. Use host-passthrough when nested virtualization is required.",
  nullable: true,
  validations: [{
    condition: cpuMode == null || contains(["host-model", "host-passthrough"], cpuMode),
    errorMessage: "cpu_mode must be null, host-model, or host-passthrough.",
  }],
}

input dataDiskSizeGib: optional<number> with {
  description: "Optional data disk capacity in GiB. When null, no data disk is created.",
  nullable: true,
  validations: [{
    condition: dataDiskSizeGib == null || (dataDiskSizeGib >= 1 && floor(dataDiskSizeGib) == dataDiskSizeGib),
    errorMessage: "data_disk_size_gib must be null or a positive whole number.",
  }],
}

input diskSizeGib: number = 10 with {
  description: "Root disk capacity in GiB.",
  validations: [{
    condition: diskSizeGib >= 1 && floor(diskSizeGib) == diskSizeGib,
    errorMessage: "disk_size_gib must be a positive whole number.",
  }],
}

input hostname: string with {
  description: "VM and guest hostname.",
  validations: [{
    condition: length(trimspace(hostname)) > 0,
    errorMessage: "hostname must not be empty."
  }],
}

input ipAddress: string with {
  description: "Static guest IPv4 address without a prefix.",
  validations: [{
    condition: can(cidrhost(f"{ipAddress}/32", 0)),
    errorMessage: "ip_address must be a valid IPv4 address."
  }],
}

input qemuGuestAgentEnabled: bool = false with {
  description: "Install qemu-guest-agent and attach its private virtio channel.",
}

input ramMb: number = 1024 with {
  description: "Guest memory in MiB.",
  validations: [{
    condition: ramMb >= 256,
    errorMessage: "ram_mb must be at least 256."
  }],
}

input rootPassword: optional<string> with {
  description: "Optional root password. SSH password authentication stays disabled when null.",
  nullable: true,
  sensitive: true,
}

input serialConsoleEnabled: bool = false with {
  description: "Reconcile an externally attached PTY serial console for virsh console access.",
}

input setupFiles: list<SetupFile> = [] with {
  description: "Additional local files written into the guest by cloud-init.",
  validations: [{
    condition: alltrue([for item in setupFiles: startswith(item.source, "/") && startswith(item.destination, "/")]),
    errorMessage: "Each setup file source and destination must start with '/'.",
  }],
}

input vcpu: number = 2 with {
  description: "Number of virtual CPUs.",
  validations: [{
    condition: vcpu >= 1,
    errorMessage: "vcpu must be at least 1."
  }],
}

input running: bool = true with { description: "Running" }

let cloudinitIsoPath = f"{trimsuffix(commonConfig.cloudinitDirectory, \"/\")}/{hostname}-cloud-init.iso"

let bootstrapFiles = [for item in setupFiles: {
  path: item.destination,
  content: filebase64(f"{commonConfig.bootstrapRoot}{item.source}"),
  encoding: "b64",
  permissions: item.permissions,
}]

let cloudConfig = {
  disableRoot: false,
  hostname,
  manageResolvConf: false,
  packages: concat(["python3"], qemuGuestAgentEnabled ? ["qemu-guest-agent"]: []),
  sshDeletekeys: true,
  sshPwauth: rootPassword != null,
  users: [{
    lockPasswd: rootPassword == null,
    name: "root",
    sshAuthorizedKeys: commonConfig.sshAuthorizedKeys,
  }],
  writeFiles: concat([
    {
      path: "/etc/cloud/cloud.cfg.d/99-disable-network-config.cfg",
      content: "network: {config: disabled}\n",
      permissions: "0644",
    },
    {
      path: "/etc/ssh/sshd_config.d/99-root-login.conf",
      content: "PermitRootLogin yes\n",
      permissions: "0644",
    },
  ], bootstrapFiles),
  runcmd: ["systemctl restart ssh || systemctl restart sshd"],
  password: rootPassword when rootPassword != null,
  chpasswd: { expire: false } when rootPassword != null,
}

let sshConnection = {
  type: "ssh",
  certificate: file(pathexpand(commonConfig.remoteCertificatePath)),
  host: commonConfig.remoteHost,
  privateKey: file(pathexpand(commonConfig.remotePrivateKeyPath)),
  user: commonConfig.remoteUser,
}

resource rootVolume = lvm.logicalVolume("root", {
  name: hostname,
  size: diskSizeGib,
  volumeGroup: commonConfig.volumeGroup,
})

resource dataVolume = lvm.logicalVolume("data", {
  name: f"{hostname}-data",
  size: dataDiskSizeGib,
  volumeGroup: commonConfig.volumeGroup,
}) when dataDiskSizeGib != null

resource dataDiskResize = terraform.data("data_disk_resize", {
  triggersReplace: [dataVolume[0].actual_size_bytes],
  connection: sshConnection,
  provisioner: [{
    "remote-exec": {
      inline: [f"virsh blockresize {jsonencode(hostname)} vdb {jsonencode(f\"{dataDiskSizeGib}G\")}"],
    },
  }],
}) with {
  dependsOn: [vm],
} when dataDiskSizeGib != null

resource rootImage = terraform.data("root_image", {
  triggersReplace: [rootVolume.uuid],
  connection: sshConnection,
  provisioner: [{
    "remote-exec": {
      inline: [f"dd if={jsonencode(commonConfig.baseImagePath)} of={jsonencode(rootVolume.path)} bs=4M conv=fsync"],
    },
  }],
}) when ! adoptExisting

resource seedDisk = libvirt.cloudinitDisk("seed", {
  name: f"{hostname}-cloud-init",
  userData: f"#cloud-config\n{yamlencode(cloudConfig)}",
  metaData: yamlencode({
    "instance-id": hostname,
    "local-hostname": hostname,
  }),
  networkConfig: yamlencode({
    version: 1,
    config: [
      {
        type: "physical",
        name: commonConfig.interfaceName,
        mtu: commonConfig.mtu,
        subnets: [{
          type: "static",
          address: f"{ipAddress}/{commonConfig.prefixLength}",
          gateway: commonConfig.gateway,
        }],
      },
      {
        type: "nameserver",
        address: [commonConfig.gateway]
      },
    ],
  }),
}) when ! adoptExisting

resource seedVolume = libvirt.volume("seed", {
  name: f"{hostname}-cloud-init.iso",
  pool: commonConfig.cloudinitPool,
  target: { format: { type: "iso" } },
  create: { content: { url: seedDisk[0].path } },
}) when ! adoptExisting

resource vm = libvirt.domain("vm", {
  name: hostname,
  type: "kvm",
  memory: ramMb,
  memoryUnit: "MiB",
  vcpu: vcpu,
  autostart: true,
  running: running,
  cpu: cpuMode == null ? null: { mode: cpuMode },
  os: {
    type: "hvm",
    typeArch: "x86_64",
    typeMachine: "q35"
  },
  features: { acpi: true },
  devices: {
    channels: qemuGuestAgentEnabled ? [{
      source: { unix: { mode: "bind" } },
      target: { virtIo: { name: "org.qemu.guest_agent.0" } },
    }]: [],
    consoles: serialConsoleEnabled ? [{
      source: { pty: { path: "" } },
      target: {
        port: 0,
        type: "serial"
      },
    }]: [],
    disks: concat(
      [{
        device: "disk",
        driver: {
          name: "qemu",
          type: "raw"
        },
        source: { block: { dev: rootVolume.path } },
        target: {
          dev: "vda",
          bus: "virtio"
        },
      }],
      [for volume in dataVolume: {
        device: "disk",
        driver: {
          name: "qemu",
          type: "raw"
        },
        source: { block: { dev: volume.path } },
        target: {
          dev: "vdb",
          bus: "virtio"
        },
      }],
      [{
        device: "cdrom",
        readOnly: true,
        source: { file: { file: adoptExisting ? cloudinitIsoPath: seedVolume[0].path } },
        target: {
          dev: "sda",
          bus: "sata"
        },
      }],
    ),
    interfaces: [{
      model: { type: "virtio" },
      source: { bridge: { bridge: commonConfig.bridge } },
    }],
  },
}) with {
  dependsOn: [rootImage],
  lifecycle: {
    ignoreChanges: [address("devices.consoles[0].source.pty.path")],
  },
}

output hostname = vm.name with { description: "Created libvirt domain name." }
output ip_address = ipAddress with { description: "Configured static guest IP address." }
output disk_path = rootVolume.path with { description: "Host path of the LVM-managed root volume." }
output data_disk_path = one([for volume in dataVolume: volume.path]) with {
  description: "Host path of the optional LVM-managed data volume.",
}
output serial_console_enabled = serialConsoleEnabled with {
  description: "Whether a PTY serial console is configured for the domain.",
}
