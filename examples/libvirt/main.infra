terraform {
  requiredVersion: ">= 1.5.0",
}

provider Libvirt from "dmacvicar/libvirt" version "~> 0.9.3"
provider Lvm from "github.com/ondrejnov/lvm" version "0.5.0"
import module LibvirtHost from "./modules/libvirt_host"

# The explicit wire alias preserves the existing Terraform variable name while source code uses camelCase.
input vmDefaults: VmDefaults = {
  baseImagePath: "/root/debian-13-generic-amd64.raw",
  bootstrapRoot: "/mnt/doc",
  bridge: "br10",
  cloudinitDirectory: "/var/lib/libvirt/images",
  cloudinitPool: "images",
  interfaceName: "enp1s0",
  mtu: 1420,
  prefixLength: 24,
  sshAuthorizedKeys: [
    "ssh-rsa ",
  ],
  volumeGroup: "vg_kvm",
} with { description: "Configuration shared by all libvirt VM module instances.", }

const hostDefinitions: map<HostDefinition> = {
  kvm1: {
    gateway: "10.0.1.254",
    remoteHost: "10.0.0.84",
    vms: {
      db1: {
        diskSizeGib: 5,
        ipAddress: "10.0.1.10"
      },
      kube: {
        cpuMode: "host-model",
        ipAddress: "10.0.1.20",
        ramMb: 1700,
        vcpu: 6
      },
      nfs: {
        ipAddress: "10.0.1.11",
        ramMb: 512
      },
      pg1: {
        diskSizeGib: 10,
        ipAddress: "10.0.1.12",
        qemuGuestAgentEnabled: true,
        ramMb: 512,
        vcpu: 1,
      },
      node1: {
        cpuMode: "host-model",
        ipAddress: "10.0.1.21",
        ramMb: 1200,
        vcpu: 6
      },
      node2: {
        cpuMode: "host-model",
        ipAddress: "10.0.1.22",
        ramMb: 1200,
        vcpu: 6
      },
    },
  },
  kvm2: {
    gateway: "10.0.2.254",
    remoteHost: "10.0.0.85",
    vms: {
      db2: {
        diskSizeGib: 5,
        ipAddress: "10.0.2.10"
      },
      kube: {
        ipAddress: "10.0.2.20",
        ramMb: 1700
      },
      nfs2: {
        ipAddress: "10.0.2.11",
        ramMb: 512
      },
      pg2: {
        diskSizeGib: 10,
        ipAddress: "10.0.2.12",
        qemuGuestAgentEnabled: true,
        ramMb: 512,
        vcpu: 1,
      },
      node1: {
        ipAddress: "10.0.2.21",
        ramMb: 1000
      },
      node2: {
        ipAddress: "10.0.2.22",
        ramMb: 1000
      },
    },
  },
}

const networkName = "staging"
const kubernetesHosts: list<string> = ["kube", "node1", "node2"]

component HostDeployment(label: string, config: HostCallConfig) using {
  libvirt: Libvirt,
  lvm: Lvm,
} {
  module host = LibvirtHost(label, {
    ...inputs(config),
  }) using { libvirt, lvm }
  export vms = host.vms
}

static for key, host in hostDefinitions {
  configure libvirtHosts[key] = Libvirt({
    uri: f"qemu+sshcmd://{vmDefaults.remoteUser}@{host.remoteHost}/system?keyfile={vmDefaults.remotePrivateKeyPath}&knownhosts=~/.ssh/known_hosts",
  })

  configure lvmHosts[key] = Lvm({
    ssh: {
      host: host.remoteHost,
      user: vmDefaults.remoteUser,
    },
  })

  instantiate hostModules[key] = HostDeployment(
    label: f"host_{key}",
    config: {
      commonConfig: {
        ...vmDefaults,
        gateway: host.gateway,
        remoteHost: host.remoteHost,
      },
      networkName,
      vms: host.vms,
    },
  ) using {
    libvirt: libvirtHosts[key],
    lvm: lvmHosts[key],
  }
}

output kubernetes = {for hostname in kubernetesHosts: hostname => hostModules["kvm1"].vms[hostname]} with {
  description: "Created Kubernetes VM details.",
}
output kubernetes2 = {for hostname in kubernetesHosts: hostname => hostModules["kvm2"].vms[hostname]} with {
  description: "Created Kubernetes VM details.",
}
output nfs = hostModules["kvm1"].vms["nfs"] with { description: "Created NFS VM details." }
output nfs2 = hostModules["kvm2"].vms["nfs2"] with { description: "Created NFS2 VM details." }
output postgresql = {
  pg1: hostModules["kvm1"].vms["pg1"],
  pg2: hostModules["kvm2"].vms["pg2"],
} with { description: "Created PostgreSQL VM details." }
